lign=middle;" vertex="1" parent="1"><mxGeometry x="1538" y="715" width="14" height="20" as="geometry"/></mxCell><mxCell id="c29" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fbe3e2;strokeColor=#555555;fontSize=13;fontColor=#000000;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1538" y="1070" width="14" height="20" as="geometry"/></mxCell><mxCell id="c30" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#555555;fontSize=13;fontColor=#000000;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1333" y="575" width="14" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#555555;fontSize=13;fontColor=#000000;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1333" y="660" width="14" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Resultado&lt;/b&gt;&lt;br&gt;Se confirman 30 litros y quedan 20; la solicitud de 25 se rechaza. Nunca se asignan 55 litros cuando solo hay 50.&lt;br&gt;Cada usuario tiene su propio proceso de Sesion, así que los comandos se procesan en paralelo; los recursos compartidos viven en GenServer&lt;br&gt;(Necesidades e Inventario) que serializan las modificaciones. Lo mismo ocurre si el orden de llegada es al revés: se confirmarían 25 y&lt;br&gt;se rechazarían 30. Este escenario se prueba en test/concurrencia_test.exs y se muestra en demo_concurrencia.exs.&lt;br&gt;Antes de este flujo cada usuario se conectó con connect (Cliente → Usuarios.autenticar_o_registrar → SesionesSupervisor.iniciar_sesion)." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="1640" height="135" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>